{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CharacterForgeAI",
  "version": "0.1.0",
  "identifier": "com.cloudygb.characterforgeai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CharacterForgeAI",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "User-friendly desktop app for building, testing, and deploying CharacterForgeAI game characters",
    "longDescription": "Installs the CharacterForgeAI desktop app for game designers, including the guided dashboard experience for character authoring, character packs, chat testing, and guarded local deployment workflows.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "CharacterForgeAI",
        "installerHooks": "installer/characterforgeai.nsh"
      }
    },
    "licenseFile": "../../../LICENSE"
  },
  "mainBinaryName": "CharacterForgeAI"
}
