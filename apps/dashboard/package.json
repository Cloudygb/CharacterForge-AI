{
  "name": "@characterforge/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "desktop:dev": "npm run tauri:dev",
    "desktop:build": "npm run tauri:build",
    "desktop:stage-installer": "node scripts/stage-windows-installer.mjs",
    "desktop:release-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-windows-installer.ps1 -ReleaseMode -SignArtifacts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "jszip": "^3.10.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.3.0",
    "vitest": "^4.0.15"
  }
}
