# CharacterForge AI local configuration example.
# Copy this file to .env for local development.

# AWS
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# DynamoDB table names
CHARACTERS_TABLE_NAME=CharacterForgeCharacters
MESSAGES_TABLE_NAME=CharacterForgeMessages

# Local development
# true = use deterministic mock responses and avoid AWS calls
# false = call AWS Bedrock when configured
USE_MOCK_LLM=true

# Optional local API settings
LOG_LEVEL=INFO
