# CharacterForge AI local configuration example.
# Copy this file to .env for local development.

# AWS
AWS_REGION=us-east-1
CHARACTERFORGE_BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
CHARACTERFORGE_BEDROCK_REGION=us-east-1

# DynamoDB table names
CHARACTERS_TABLE_NAME=CharacterForgeCharacters
MESSAGES_TABLE_NAME=CharacterForgeMessages

# Local development
# true = use deterministic mock responses and avoid AWS calls once the Lambda/API adapter is wired
# false = call AWS Bedrock when configured once the Lambda/API adapter is wired
USE_MOCK_LLM=true

# Optional local API settings
LOG_LEVEL=INFO

# Local-only API key check. Leave false for deployed stacks because API Gateway
# usage plans are the primary auth layer there.
CHARACTERFORGE_REQUIRE_LOCAL_API_KEY=false
# CHARACTERFORGE_API_KEY=replace-with-a-local-development-key
